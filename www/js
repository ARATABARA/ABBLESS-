// ==========================
// ABBLESS AI CHAT
// ==========================


function sendAI(){


let input=document.getElementById("aiQuestion");


let message=input.value;



if(message===""){

return;

}



let chat=document.getElementById("aiChat");



chat.innerHTML += `

<div class="ai-message">

<div class="bubble user">

${message}

</div>

</div>

`;





setTimeout(()=>{


chat.innerHTML += `

<div class="ai-message">

<div class="avatar">

🤖

</div>


<div class="bubble ai">

I am ABBLESS AI. I will help you learn about ${message}.

</div>

</div>

`;


chat.scrollTop=chat.scrollHeight;


},800);



input.value="";


}





