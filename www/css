/* ======================
NEW ABBLESS DESIGN
====================== */


.page-header{

display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:25px;

}


.page-header h2{

color:var(--green);

}



/* ======================
AI CHATGPT STYLE
====================== */


.ai-header{

display:flex;
justify-content:space-between;
align-items:center;

}


.ai-chat{

height:65vh;

overflow-y:auto;

padding:15px;

background:#111;

border-radius:20px;

}



.ai-message{

display:flex;

margin-bottom:20px;

}



.avatar{

font-size:30px;

margin-right:10px;

}



.bubble{

padding:15px;

border-radius:20px;

max-width:80%;

}



.bubble.ai{

background:#1a1a1a;

border:1px solid var(--green);

}



.bubble.user{

background:var(--blue);

margin-left:auto;

}



.ai-input{

position:fixed;

bottom:10px;

left:50%;

transform:translateX(-50%);

width:95%;

max-width:700px;

display:flex;

gap:8px;

background:#1a1a1a;

padding:10px;

border-radius:30px;

}



.ai-input input{

flex:1;

padding:12px;

border-radius:25px;

background:#000;

color:white;

border:1px solid var(--green);

}



/* ======================
ADMIN DASHBOARD
====================== */


.admin-dashboard{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:20px;

}



.admin-card{

background:#1a1a1a;

padding:25px;

border-radius:20px;

border:1px solid var(--violet);

text-align:center;

}



.admin-card:hover{

transform:translateY(-5px);

transition:.3s;

border-color:var(--green);

}



.admin-card h3{

color:var(--green);

margin:15px;

}




/* ======================
PROFILE
====================== */


.profile-card{

background:var(--card);

padding:30px;

border-radius:25px;

max-width:500px;

margin:auto;

text-align:center;

border:1px solid var(--green);

}



.profile-image{

font-size:80px;

}



/* ======================
PAYMENT
====================== */


.payment-card{

background:var(--card);

padding:30px;

max-width:500px;

margin:auto;

border-radius:25px;

}



.payment-card button{

display:block;

width:90%;

margin:15px auto;

background:var(--green);

}



.payment-card button:hover{

background:var(--blue);

}



/* ======================
NOTIFICATIONS
====================== */


.notification-item{

background:#111;

padding:20px;

margin:15px;

border-radius:15px;

border-left:4px solid var(--green);

}



/* ======================
MESSAGE ITEM
====================== */


.message-item{

background:#111;

padding:15px;

margin:15px 0;

border-radius:15px;

}




/* ======================
MOBILE
====================== */


@media(max-width:600px){


.ai-chat{

height:60vh;

}


.admin-dashboard{

grid-template-columns:1fr;

}


.page-header h2{

font-size:20px;

}


}