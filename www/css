*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}


:root{

    --black:#0D0D0D;
    --card:#1A1A1A;
    --white:#FFFFFF;
    --green:#22C55E;
    --blue:#2563EB;
    --violet:#7C3AED;
    --gray:#2E2E2E;

}



body{

    background:var(--black);
    color:var(--white);
    min-height:100vh;

}



/* =====================
GENERAL PAGE SYSTEM
===================== */


.page{

    display:none;
    min-height:100vh;
    padding:20px;

}



.page.active{

    display:block;

}



/* =====================
SPLASH SCREEN
===================== */


#splash{

    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;

}



.logo-box h1{

    color:var(--green);
    font-size:45px;

}



.logo-box p{

    color:var(--white);
    font-size:18px;

}



.logo{

    font-size:70px;

}



/* =====================
PRESENTATION
===================== */


.container{

    display:flex;
    justify-content:center;
    align-items:center;
    min-height:90vh;

}



.brand{

    text-align:center;
    max-width:600px;

}



.brand h1{

    color:var(--blue);
    font-size:40px;

}



.brand p{

    margin:20px;
    line-height:1.6;

}




button{

    background:var(--green);
    color:#000;

    border:none;
    padding:12px 25px;

    border-radius:25px;

    cursor:pointer;

    font-weight:bold;

}



button:hover{

    background:var(--blue);
    color:white;

}



/* =====================
REGISTER FORM
===================== */


.form-box{

    max-width:400px;

    margin:80px auto;

    background:var(--card);

    padding:30px;

    border-radius:20px;

    text-align:center;

}



.form-box h2{

    color:var(--green);

    margin-bottom:25px;

}



.form-box input{

    width:100%;

    padding:15px;

    margin:10px 0;

    border-radius:10px;

    border:1px solid var(--gray);

    background:#000;

    color:white;

}/* =====================
HOME TOP BAR
===================== */

.top-bar{

    display:flex;

    justify-content:space-between;

    align-items:center;

    background:var(--card);

    padding:15px 20px;

    border-radius:15px;

    position:sticky;

    top:0;

}



.app-logo{

    color:var(--green);

    font-size:22px;

    font-weight:bold;

}



.top-actions{

    display:flex;

    gap:10px;

}



.top-actions button{

    width:40px;

    height:40px;

    padding:0;

    border-radius:50%;

    background:var(--blue);

    color:white;

}





/* =====================
HOME CONTENT
===================== */


.home-content{

    text-align:center;

    padding:50px 20px;

}



.home-content h2{

    color:var(--green);

    font-size:35px;

}



.home-content p{

    color:#ccc;

}




/* =====================
BOTTOM HORIZONTAL NAV
===================== */


.bottom-nav{

    position:fixed;

    bottom:15px;

    left:50%;

    transform:translateX(-50%);

    width:95%;

    max-width:700px;

    display:flex;

    justify-content:space-around;

    align-items:center;

    background:var(--card);

    padding:10px;

    border-radius:25px;

    border:1px solid var(--gray);

}



.bottom-nav button{

    background:transparent;

    color:white;

    font-size:12px;

    padding:8px;

}



.bottom-nav button:hover{

    color:var(--green);

    background:transparent;

}





/* =====================
FEATURE PAGES
===================== */


.feature-page{

    text-align:center;

    padding-bottom:120px;

}



.feature-page h2{

    color:var(--blue);

    margin:30px;

}



.feature-card{

    background:var(--card);

    max-width:600px;

    margin:20px auto;

    padding:30px;

    border-radius:20px;

    border-left:5px solid var(--green);

}



.feature-card h3{

    color:var(--green);

}



.feature-card button{

    margin:8px;

}




/* =====================
AI BOX
===================== */


.ai-box{

    background:var(--card);

    max-width:600px;

    margin:auto;

    padding:30px;

    border-radius:20px;

    border:2px solid var(--blue);

}



.ai-box input{

    width:80%;

    padding:12px;

    margin-top:20px;

    border-radius:20px;

    background:#000;

    color:white;

    border:1px solid var(--blue);

}




/* =====================
QUIZ
===================== */


.quiz-box{

    background:var(--card);

    max-width:500px;

    margin:auto;

    padding:30px;

    border-radius:20px;

}



.quiz-box button{

    margin:10px;

    background:var(--violet);

    color:white;

}
/* =====================
ADMIN PANEL
===================== */

.admin-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

    gap:20px;

    max-width:900px;

    margin:auto;

}



.admin-card{

    background:var(--card);

    padding:25px;

    border-radius:20px;

    border:2px solid var(--violet);

    text-align:center;

}



.admin-card h3{

    color:var(--violet);

    margin:15px 0;

}



.admin-card p{

    color:#ccc;

}





/* =====================
ADMIN TOOLS
===================== */


#adminTools .feature-card button{

    background:var(--violet);

    color:white;

    display:block;

    width:80%;

    margin:12px auto;

}





/* =====================
SETTINGS & MENU
===================== */


#settings button,
#menu button{

    background:var(--blue);

    color:white;

    display:block;

    width:80%;

    margin:15px auto;

}





/* =====================
FOOTER
===================== */


footer{

    background:var(--card);

    text-align:center;

    padding:30px;

    margin-top:50px;

    color:#ccc;

}



footer h2{

    color:var(--green);

}





/* =====================
RESPONSIVE MOBILE
===================== */


@media(max-width:600px){


.top-bar{

    padding:10px;

}


.app-logo{

    font-size:18px;

}



.top-actions button{

    width:35px;

    height:35px;

}



.bottom-nav{

    width:100%;

    bottom:0;

    border-radius:0;

}



.bottom-nav button{

    font-size:10px;

}



.brand h1{

    font-size:30px;

}



.logo-box h1{

    font-size:35px;

}



.feature-card{

    margin:15px 5px;

}



}